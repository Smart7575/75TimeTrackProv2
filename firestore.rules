rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Project Validation
    function isValidProject(data) {
      return (!('name' in data) || data.name == null || (data.name is string && data.name.size() < 100)) &&
             (!('client' in data) || data.client == null || (data.client is string && data.client.size() < 100)) &&
             (!('clientId' in data) || data.clientId == null || data.clientId is string) &&
             (!('color' in data) || data.color == null || data.color is string) &&
             (!('budget' in data) || data.budget == null || data.budget is int || data.budget is float || data.budget is string) &&
             (!('rate' in data) || data.rate == null || data.rate is int || data.rate is float || data.rate is string) &&
             (!('activities' in data) || data.activities == null || data.activities is list) &&
             (!('subProjects' in data) || data.subProjects == null || data.subProjects is list) &&
             (!('archived' in data) || data.archived == null || data.archived is bool) &&
             (!('id' in data) || data.id == null || data.id is string) &&
             !('isAdmin' in data);
    }

    // Entry Validation
    function isValidEntry(data) {
      return (!('projectId' in data) || data.projectId is string) &&
             (!('activityId' in data) || data.activityId is string) &&
             (!('startTime' in data) || data.startTime is timestamp) &&
             (!('durationInMinutes' in data) || data.durationInMinutes == null || data.durationInMinutes is int || data.durationInMinutes is float || data.durationInMinutes is string) &&
             (!('classification' in data) || data.classification is string) &&
             (!('subProjectId' in data) || data.subProjectId == null || data.subProjectId is string) &&
             (!('notes' in data) || data.notes == null || data.notes is string);
    }

    // Task Validation
    function isValidTask(data) {
      return (!('name' in data) || (data.name is string && data.name.size() < 100)) &&
             (!('subTasks' in data) || data.subTasks == null || data.subTasks is list);
    }

    // Settings Validation
    function isValidSettings(data) {
      return (!('coreNorm' in data) || data.coreNorm == null || data.coreNorm is int || data.coreNorm is float || data.coreNorm is string) &&
             (!('language' in data) || data.language is string) &&
             (!('theme' in data) || data.theme is string);
    }

    // Client Validation
    function isValidClient(data) {
      return (!('name' in data) || (data.name is string && data.name.size() < 100)) &&
             (!('contactPersons' in data) || data.contactPersons == null || data.contactPersons is list) &&
             (!('archived' in data) || data.archived == null || data.archived is bool);
    }

    // ActiveTimer Validation
    function isValidActiveTimer(data) {
      return (!('projectId' in data) || data.projectId is string) &&
             (!('activityId' in data) || data.activityId is string) &&
             (!('startTime' in data) || data.startTime is timestamp) &&
             (!('subProjectId' in data) || data.subProjectId == null || data.subProjectId is string) &&
             (!('notes' in data) || data.notes == null || data.notes is string);
    }

    match /users/{userId} {
      // Identity Protection Gate
      allow read, write: if isOwner(userId);

      match /projects/{projectId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && 
                         incoming().keys().hasAll(['name', 'client']) &&
                         incoming().name is string && incoming().name.size() > 0 &&
                         incoming().client is string && incoming().client.size() > 0 &&
                         isValidProject(incoming());
        allow update: if isOwner(userId) && 
                         isValidProject(incoming()) && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['id', 'name', 'client', 'clientId', 'color', 'budget', 'rate', 'activities', 'subProjects', 'archived']);
        allow delete: if isOwner(userId);
      }

      match /clients/{clientId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(clientId) && isValidClient(incoming());
        allow update: if isOwner(userId) && isValidClient(incoming());
        allow delete: if isOwner(userId);
      }

      match /entries/{entryId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId) && isValidEntry(incoming());
        allow update: if isOwner(userId) && isValidEntry(incoming());
        allow delete: if isOwner(userId);
      }

      match /coreTasks/{taskId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming());
        allow update: if isOwner(userId) && isValidTask(incoming());
        allow delete: if isOwner(userId);
      }

      match /settings/general {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSettings(incoming());
      }

      match /settings/activeTimer {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidActiveTimer(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
